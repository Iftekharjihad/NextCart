@model IEnumerable<NextCart.Models.CartItem>

<h2>Checkout</h2>

<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Total</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Product.Name</td>
                <td>@item.Product.Price</td>
                <td>@item.Quantity</td>
                <td>@(item.Product.Price* item.Quantity)</td>
            </tr>
        }
    </tbody>
</table>

<h3>Total Bill: @ViewBag.Total</h3>

<form asp-action="PlaceOrder" method="post">

    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-success">
        Place Order
    </button>

</form>